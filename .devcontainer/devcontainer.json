{
    "name": "SWRT Build Env",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "remoteUser": "docker",
    "updateRemoteUserUID": false,
    
    "runArgs": [
        "--cap-add=SYS_PTRACE",
        "--security-opt", "seccomp=unconfined",
        "--name", "swrt-build-env"
    ],
    
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            },
            "extensions": [
                "ms-vscode.cpptools",
                "ms-python.python"
            ]
        }
    },
    
    "postCreateCommand": "sudo bash -c 'source /home/docker/envs/toolchain.sh && source /home/docker/envs/bcm.sh && chmod 755 /home/docker && chmod -R 755 /home/docker/*-toolchains/'",
    
}
